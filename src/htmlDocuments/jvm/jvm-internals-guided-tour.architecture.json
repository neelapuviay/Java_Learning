  "cards": [
    {
      "dot": "cyan",
      "title": "The one program followed",
      "items": [
        "static int created = 0; final int id;",
        "constructor stores id and increments created",
        "work() returns id * 2",
        "main creates many objects and repeatedly calls work()"
      ]
    },
    {
      "dot": "amber",
      "title": "Where each thing lives",
      "items": [
        "Metaspace: class shape, bytecode, methods, runtime constant pool",
        "Heap Class mirror: static field value JvmTour.created",
        "Heap instance: object header and each object's id",
        "Frame: parameters, locals, operand stack, return data",
        "Code Cache: JIT-compiled native instructions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Optimization and collection loops",
      "items": [
        "C1 compiles quickly; C2 uses profiles for aggressive optimization",
        "OSR enters compiled code inside a hot loop",
        "Failed assumptions deoptimize into reconstructed interpreter frames",
        "GC roots include active frames, JNI handles, and live class statics",
        "Class unloading can reclaim Metaspace after its loader is unreachable"
      ]
    }
  ]
