  "cards": [
    {
      "dot": "cyan",
      "title": "The program followed in every stage",
      "items": [
        "class JvmTour { static int created = 0; final int id; }",
        "JvmTour(int id) { this.id = id; created++; }",
        "int work() { return id * 2; }",
        "main creates many JvmTour objects and repeatedly calls work()",
        "The loop makes work() hot enough to demonstrate tiered JIT compilation"
      ]
    },
    {
      "dot": "amber",
      "title": "Static, instance, local: do not mix them up",
      "items": [
        "Metaspace: class shape, method metadata, bytecode, runtime constant pool",
        "Heap Class mirror: the static field value JvmTour.created",
        "Heap instance: each object's id field and object header",
        "Stack frame: parameters, local variables, operand stack, return data",
        "A local reference is in a frame; the referenced object remains on the heap"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution becomes faster as evidence grows",
      "items": [
        "Interpreter starts immediately and records branch, call, and type profiles",
        "C1 produces useful machine code quickly; higher tiers retain profiling",
        "C2 spends more time on inlining, escape analysis, and speculative optimization",
        "OSR can enter compiled code inside a running hot loop",
        "A failed assumption triggers deoptimization back to reconstructed interpreter frames"
      ]
    },
    {
      "dot": "rose",
      "title": "What garbage collection actually controls",
      "items": [
        "Roots include active frame references, JNI handles, and live class static references",
        "Young, mixed, or full cycles depend on collector and allocation pressure",
        "Safepoints coordinate operations that need a consistent JVM view",
        "GC reclaims unreachable heap objects; stack frames disappear when calls return",
        "Class unloading can reclaim Metaspace only after its defining loader becomes unreachable"
      ]
    }
  ]
}